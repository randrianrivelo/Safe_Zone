# Frontend Environment Configuration
# Copy this file to .env.local and update the values as needed

# API Configuration
VITE_API_BASE_URL=http://192.168.232.150:8000/api

# App Configuration
VITE_APP_NAME=Safe Zone 2035
VITE_APP_DESCRIPTION=Platform de gestion de crises urbaines

# Debug Mode
VITE_DEBUG_MODE=false

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_WEATHER=true
VITE_ENABLE_ALERTS=true

# Map Configuration
VITE_MAP_CENTER_LAT=48.8566
VITE_MAP_CENTER_LNG=2.3522
VITE_MAP_ZOOM=13

# Timeout Configuration (in milliseconds)
VITE_API_TIMEOUT=15000
VITE_REQUEST_RETRY_ATTEMPTS=3
VITE_REQUEST_RETRY_DELAY=1000
