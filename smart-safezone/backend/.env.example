# Smart Safe Zone - Variables d'environnement

# ========================================
# Configuration MySQL
# ========================================
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=smart_safezone

# ========================================
# Configuration JWT & Sécurité
# ========================================
SECRET_KEY=votre-clé-secrète-très-sûre-changez-la-en-production-avec-une-vraie-clé-aléatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# Configuration API
# ========================================
API_TITLE=Smart Safe Zone API
API_VERSION=1.0.0
API_DESCRIPTION=API de gestion des zones de sécurité en cas de catastrophe naturelle

# ========================================
# CORS
# ========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO

# ========================================
# Mode développement/production
# ========================================
ENVIRONMENT=development
# ENVIRONMENT=production
